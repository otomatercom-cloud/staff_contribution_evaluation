<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_staff_contribution_evaluation_reporting_search" model="ir.ui.view">
            <field name="name">staff.contribution.evaluation.reporting.search</field>
            <field name="model">staff.contribution.evaluation</field>
            <field name="arch" type="xml">
                <search string="Contribution Evaluation Reporting">
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="department_id"/>
                    <field name="work_location_id"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="This Year" name="this_year" domain="[('evaluation_year', '=', context_today().strftime('%Y'))]"/>
                    <separator/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'work_location_id'}"/>
                    <filter string="Quarter" name="group_quarter" context="{'group_by': 'quarter'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'evaluation_year'}"/>
                    <filter string="Overall Rating" name="group_rating" context="{'group_by': 'overall_rating'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="action_staff_contribution_evaluation_reporting" model="ir.actions.act_window">
            <field name="name">Reporting</field>
            <field name="res_model">staff.contribution.evaluation</field>
            <field name="view_mode">pivot,graph,list</field>
            <field name="search_view_id" ref="view_staff_contribution_evaluation_reporting_search"/>
            <field name="context">{'search_default_group_department': 1}</field>
        </record>

    </data>
</odoo>
