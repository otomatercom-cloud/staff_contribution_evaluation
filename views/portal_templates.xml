<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_evaluation_list" name="My Contribution Evaluations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="o_portal_contribution_evaluation">
                <div class="sce-header-banner d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="/staff_contribution_evaluation/static/src/img/logo.png" alt="Logic School of Management" class="sce-header-logo"/>
                        <div>
                            <div class="sce-eyebrow">Staff Contribution Evaluation</div>
                            <h2 class="mb-0">Quarterly Contribution Evaluations</h2>
                            <div class="sce-sub">Track and submit your quarterly contributions across all sections.</div>
                        </div>
                    </div>
                    <t t-if="employee">
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newEvaluationModal">
                            <i class="fa fa-plus me-1"/>New Evaluation
                        </button>
                    </t>
                </div>

                <t t-if="not employee">
                    <div class="alert alert-warning">
                        No employee record is linked to your account. Please contact HR.
                    </div>
                </t>

                <t t-elif="not evaluations">
                    <div class="sce-howto">
                        <p class="mb-0">You have no contribution evaluations yet. Click <strong>"New Evaluation"</strong> to get started.</p>
                    </div>
                </t>

                <div t-if="evaluations" class="table-responsive">
                    <table class="table table-hover sce-list-table mb-0">
                        <thead>
                            <tr>
                                <th>Evaluation No.</th>
                                <th>Quarter</th>
                                <th>Status</th>
                                <th>Final Score</th>
                                <th>Overall Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="evaluations" t-as="evaluation">
                                <td>
                                    <a t-attf-href="/my/contribution-evaluations/#{evaluation.id}" class="fw-bold text-decoration-none">
                                        <span t-esc="evaluation.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-esc="evaluation.quarter"/> <span t-esc="evaluation.evaluation_year"/>
                                </td>
                                <td>
                                    <span t-attf-class="sce-status-pill status-#{evaluation.state}" t-esc="evaluation.state"/>
                                </td>
                                <td>
                                    <t t-if="evaluation.score_line_ids">
                                        <span class="fw-bold" t-esc="'%.1f' % evaluation.final_score"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                                <td>
                                    <span t-if="evaluation.overall_rating" t-esc="evaluation.overall_rating"/>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal fade" id="newEvaluationModal" tabindex="-1">
                <div class="modal-dialog">
                    <form t-attf-action="/my/contribution-evaluations/new" method="post" class="modal-content">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-header">
                            <h5 class="modal-title">New Quarterly Evaluation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Quarter</label>
                                <select name="quarter" class="form-select">
                                    <option value="q1">Q1 (Jan - Mar)</option>
                                    <option value="q2">Q2 (Apr - Jun)</option>
                                    <option value="q3">Q3 (Jul - Sep)</option>
                                    <option value="q4">Q4 (Oct - Dec)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Year</label>
                                <input type="text" name="evaluation_year" class="form-control" maxlength="4" placeholder="2026"/>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_evaluation_form" name="Contribution Evaluation Form">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="o_portal_contribution_evaluation">
                <div class="sce-header-banner d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="/staff_contribution_evaluation/static/src/img/logo.png" alt="Logic School of Management" class="sce-header-logo"/>
                        <div>
                            <div class="sce-eyebrow">Quarterly Contribution Evaluation</div>
                            <h2 class="mb-1"><span t-esc="evaluation.name"/></h2>
                            <div class="sce-sub">
                                <span t-esc="evaluation.employee_id.name"/> ·
                                <span t-esc="evaluation.quarter"/> <span t-esc="evaluation.evaluation_year"/>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <span t-attf-class="sce-status-pill status-#{evaluation.state}" t-esc="evaluation.state"/>
                        <t t-if="evaluation.state == 'draft'">
                            <form t-attf-action="/my/contribution-evaluations/#{evaluation.id}/submit" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-success ms-2">Submit for Review</button>
                            </form>
                        </t>
                    </div>
                </div>

                <div class="sce-progress-nav">
                    <div class="sce-progress-label">
                        <span t-esc="len([s for s in sections_data if s['cards']])"/> of <span t-esc="len(sections_data)"/> sections have entries — jump to a section:
                    </div>
                    <div class="sce-progress-track">
                        <t t-foreach="sections_data" t-as="nav_s">
                            <a t-attf-href="#section-#{nav_s['code']}"
                               t-attf-class="sce-nav-pill #{'sce-nav-empty' if not nav_s['cards'] else ''}"
                               t-attf-style="--pill-color: #{nav_s['cat_color']};"
                               t-attf-title="#{nav_s['cfg']['title']}">
                                <span t-esc="nav_s['code'].upper()"/>
                                <span class="sce-nav-count" t-esc="len(nav_s['cards'])"/>
                            </a>
                        </t>
                    </div>
                </div>

                <div class="sce-howto">
                    <h5 class="alert-heading"><i class="fa fa-info-circle me-1"/>How to fill this form</h5>
                    <ol class="mb-0 ps-3">
                        <li>Open each section below (click its title to expand), or jump to one using the colored pills above.</li>
                        <li>
                            For sections with a tick-list (e.g. Revenue Contribution, Cost Reduction): each row is one
                            contribution type. Tick <strong>Include</strong> for every type that applies this quarter,
                            fill in that row's own Activity/amount/rating — each ticked row is saved as its own separate
                            entry, so multiple types stay clearly distinct. Then click <strong>Add Selected</strong>.
                        </li>
                        <li>
                            For sections without a tick-list (e.g. Placement, Innovation, Best Contribution): fill in the
                            single form shown and click <strong>Add Entry</strong>.
                        </li>
                        <li>Repeat for every section that applies to you — you can leave sections empty if nothing applies.</li>
                        <li>
                            Evidence: tick "Evidence" on a row to reveal a file upload right there — attach it before
                        clicking Add Selected.
                    </li>
                    <li>Add an optional note in <strong>Employee Remarks</strong> at the bottom, then click <strong>Submit for Review</strong> when everything is entered.</li>
                </ol>
            </div>

            <div class="accordion sce-accordion" id="sectionsAccordion">
                <t t-foreach="sections_data" t-as="sdata">
                    <t t-set="cfg" t-value="sdata['cfg']"/>
                    <t t-set="sec_code" t-value="sdata['code']"/>
                    <t t-set="is_row_section" t-value="cfg.get('has_types') or cfg.get('has_departments')"/>
                    <div class="accordion-item" t-attf-id="section-#{sec_code}" t-attf-style="--cat-color: #{sdata['cat_color']};">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" t-attf-data-bs-target="#collapse-#{sec_code}">
                                <span t-esc="cfg['title']"/>
                                <span class="sce-cat-badge" t-esc="sdata['category']"/>
                                <span class="badge text-bg-light border ms-2" t-esc="len(sdata['cards'])"/>
                            </button>
                        </h2>
                        <div t-attf-id="collapse-#{sec_code}" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p t-if="cfg.get('intro')" class="text-muted fst-italic" t-esc="cfg['intro']"/>
                                <p t-if="is_row_section" class="text-muted small">
                                    Tick each row that applies and fill in its own details — every ticked row becomes its own separate entry.
                                </p>

                                <div t-if="sdata['cards']" class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                                    <t t-foreach="sdata['cards']" t-as="card">
                                        <div class="col">
                                            <div class="sce-entry-card h-100" t-attf-style="--cat-color: #{sdata['cat_color']};">
                                                <div class="card-body">
                                                    <h6 class="card-title" t-esc="card['title']"/>
                                                    <div t-if="cfg.get('has_types')" class="small mb-1">
                                                        <span class="badge text-bg-light border" t-esc="card['line'].contribution_type_id.name"/>
                                                    </div>
                                                    <div t-if="cfg.get('has_departments')" class="small mb-1">
                                                        <span class="badge text-bg-light border" t-esc="card['line'].department_id.name"/>
                                                    </div>
                                                    <t t-foreach="card['details']" t-as="detail">
                                                        <div class="small text-muted">
                                                            <span t-esc="detail[0]"/>: <span t-esc="detail[1]"/>
                                                        </div>
                                                    </t>
                                                    <div t-if="cfg.get('has_self_rating')" class="small text-muted">
                                                        Self-Rating: <span t-esc="card['line'].self_rating"/>/5
                                                    </div>
                                                    <div t-if="cfg.get('has_evidence')" class="small text-muted">
                                                        Evidence:
                                                        <t t-if="card['line'].has_evidence">Yes</t>
                                                        <t t-else="">No</t>
                                                    </div>
                                                    <form t-if="evaluation.state == 'draft'"
                                                          t-attf-action="/my/contribution-evaluations/#{evaluation.id}/line/#{card['line'].id}/delete"
                                                          method="post" class="mt-2">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <!-- Row-table bulk add: one row per contribution type / department -->
                                <form t-if="evaluation.state == 'draft' and is_row_section"
                                      t-attf-action="/my/contribution-evaluations/#{evaluation.id}/section/#{sec_code}/bulk-add"
                                      method="post" enctype="multipart/form-data" class="border rounded p-3 bg-light">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-2 sce-tick-table">
                                            <thead>
                                                <tr>
                                                    <th>Include</th>
                                                    <th t-esc="'Department' if cfg.get('has_departments') else 'Type'"/>
                                                    <th>Activity</th>
                                                    <t t-foreach="cfg['fields']" t-as="fdef">
                                                        <th t-if="fdef[0] != 'name'" t-esc="fdef[1]"/>
                                                    </t>
                                                    <th t-if="cfg.get('has_self_rating')">Self-Rating</th>
                                                    <th t-if="cfg.get('has_evidence')">Evidence</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="sdata['items']" t-as="item">
                                                    <td>
                                                        <input class="form-check-input" type="checkbox" t-attf-name="include_#{item.id}"/>
                                                    </td>
                                                    <td t-esc="item.name"/>
                                                    <td>
                                                        <input type="text" t-attf-name="name_#{item.id}" class="form-control form-control-sm" style="min-width:140px;"/>
                                                    </td>
                                                    <t t-foreach="cfg['fields']" t-as="fdef">
                                                        <t t-set="fname" t-value="fdef[0]"/>
                                                        <t t-set="ftype" t-value="fdef[2]"/>
                                                        <td t-if="fname != 'name'">
                                                            <textarea t-if="ftype == 'text'" t-attf-name="#{fname}_#{item.id}" class="form-control form-control-sm" rows="1"/>
                                                            <input t-elif="ftype == 'integer'" type="number" t-attf-name="#{fname}_#{item.id}" class="form-control form-control-sm" style="min-width:90px;" step="1" min="0"/>
                                                            <input t-elif="ftype == 'monetary'" type="number" t-attf-name="#{fname}_#{item.id}" class="form-control form-control-sm" style="min-width:100px;" step="0.01" min="0"/>
                                                            <input t-else="" type="text" t-attf-name="#{fname}_#{item.id}" class="form-control form-control-sm"/>
                                                        </td>
                                                    </t>
                                                    <td t-if="cfg.get('has_self_rating')">
                                                        <select t-attf-name="self_rating_#{item.id}" class="form-select form-select-sm" style="min-width:60px;">
                                                            <option value="0">0</option>
                                                            <option value="1">1</option>
                                                            <option value="2">2</option>
                                                            <option value="3">3</option>
                                                            <option value="4">4</option>
                                                            <option value="5">5</option>
                                                        </select>
                                                    </td>
                                                    <td t-if="cfg.get('has_evidence')">
                                                        <input class="form-check-input" type="checkbox" t-attf-name="has_evidence_#{item.id}"
                                                               t-attf-id="evidence-toggle-#{sec_code}-#{item.id}"
                                                               t-attf-onchange="document.getElementById('evidence-file-#{sec_code}-#{item.id}').classList.toggle('d-none', !this.checked)"/>
                                                        <input type="file" t-attf-name="evidence_file_#{item.id}" class="form-control form-control-sm mt-1 d-none"
                                                               t-attf-id="evidence-file-#{sec_code}-#{item.id}" style="min-width:160px;"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-plus me-1"/>Add Selected
                                    </button>
                                </form>

                                <!-- Single-entry add for sections with no tick-list -->
                                <form t-if="evaluation.state == 'draft' and not is_row_section"
                                      t-attf-action="/my/contribution-evaluations/#{evaluation.id}/line/#{sec_code}/add"
                                      method="post" enctype="multipart/form-data" class="border rounded p-3 bg-light">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row g-3">
                                        <t t-foreach="cfg['fields']" t-as="fdef">
                                            <t t-set="fname" t-value="fdef[0]"/>
                                            <t t-set="flabel" t-value="fdef[1]"/>
                                            <t t-set="ftype" t-value="fdef[2]"/>
                                            <div t-attf-class="#{'col-12' if ftype == 'text' else 'col-12 col-md-6'}">
                                                <label class="form-label" t-esc="flabel"/>
                                                <textarea t-if="ftype == 'text'" t-att-name="fname" class="form-control" rows="2"/>
                                                <input t-elif="ftype == 'integer'" type="number" t-att-name="fname"
                                                       class="form-control" step="1" min="0"/>
                                                <div t-elif="ftype == 'monetary'" class="input-group">
                                                    <span class="input-group-text" t-esc="evaluation.currency_id.symbol"/>
                                                    <input type="number" t-att-name="fname" class="form-control" step="0.01" min="0"/>
                                                </div>
                                                <input t-elif="fname == 'name'" type="text" t-att-name="fname"
                                                       class="form-control" required="required"/>
                                                <input t-else="" type="text" t-att-name="fname" class="form-control"/>
                                            </div>
                                        </t>
                                    </div>

                                    <div t-if="cfg.get('has_self_rating')" class="mt-3">
                                        <label class="form-label">Self-Rating (0-5)</label>
                                        <select name="self_rating" class="form-select" style="max-width:120px;">
                                            <option value="0">0</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                        </select>
                                    </div>

                                    <div t-if="cfg.get('has_evidence')" class="mt-3">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" name="has_evidence"
                                                   t-attf-id="evidence-toggle-#{sec_code}"
                                                   t-attf-onchange="document.getElementById('evidence-file-#{sec_code}').classList.toggle('d-none', !this.checked)"/>
                                            <label class="form-check-label" t-attf-for="evidence-toggle-#{sec_code}">Supporting Evidence Attached</label>
                                        </div>
                                        <div t-attf-id="evidence-file-#{sec_code}" class="mt-2 d-none">
                                            <input type="file" name="evidence_file" class="form-control"/>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary mt-3">
                                        <i class="fa fa-plus me-1"/>Add Entry
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <div class="card mt-4 sce-remarks-card">
                <div class="card-header">Employee Remarks</div>
                <div class="card-body">
                    <form t-if="evaluation.state == 'draft'"
                          t-attf-action="/my/contribution-evaluations/#{evaluation.id}/save-remarks" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <textarea name="employee_remarks" class="form-control" rows="3"><t t-esc="evaluation.employee_remarks"/></textarea>
                        <button type="submit" class="btn btn-outline-primary mt-2">Save Remarks</button>
                    </form>
                    <p t-else="" t-esc="evaluation.employee_remarks or 'No remarks.'"/>
                </div>
            </div>
            </div>
        </t>
    </template>
</odoo>
