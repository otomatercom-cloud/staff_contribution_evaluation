<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================== Contribution Type ===================== -->
        <record id="view_staff_contribution_type_list" model="ir.ui.view">
            <field name="name">staff.contribution.type.list</field>
            <field name="model">staff.contribution.type</field>
            <field name="arch" type="xml">
                <list string="Contribution Types" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="section"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_staff_contribution_type" model="ir.actions.act_window">
            <field name="name">Contribution Types</field>
            <field name="res_model">staff.contribution.type</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- ===================== Evidence Type ===================== -->
        <record id="view_staff_evidence_type_list" model="ir.ui.view">
            <field name="name">staff.evidence.type.list</field>
            <field name="model">staff.evidence.type</field>
            <field name="arch" type="xml">
                <list string="Evidence Types" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_staff_evidence_type" model="ir.actions.act_window">
            <field name="name">Evidence Types</field>
            <field name="res_model">staff.evidence.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ===================== Evaluation Criteria ===================== -->
        <record id="view_staff_evaluation_criteria_list" model="ir.ui.view">
            <field name="name">staff.evaluation.criteria.list</field>
            <field name="model">staff.evaluation.criteria</field>
            <field name="arch" type="xml">
                <list string="Evaluation Criteria" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="weight" string="Weight (%)" sum="Total"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_staff_evaluation_criteria_form" model="ir.ui.view">
            <field name="name">staff.evaluation.criteria.form</field>
            <field name="model">staff.evaluation.criteria</field>
            <field name="arch" type="xml">
                <form string="Evaluation Criteria">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="weight"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <field name="description" placeholder="Explain how managers should score this criterion (0-100)..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_staff_evaluation_criteria" model="ir.actions.act_window">
            <field name="name">Evaluation Criteria</field>
            <field name="res_model">staff.evaluation.criteria</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
